---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<BaseLayout title="Projects" description="Selected residential, multifamily, and commercial projects in Southwest Florida.">
  <section class="section">
    <div class="wrap">
      <p class="t-eyebrow">Portfolio</p>
      <h1 class="t-h1">Projects</h1>
      <div class="grid">
        {projects.map((project) => (
          <a class="card" href={`/projects/${project.id}`}>
            <div class="thumb" style={`background-image:url('${project.data.cover}')`}></div>
            <h2 class="t-h3">{project.data.title}</h2>
            <p class="t-small">
              {project.data.location} · {project.data.year}
            </p>
            <p class="t-body">{project.data.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .grid {
    display: grid;
    gap: 1.75rem;
    margin-top: 2rem;
  }

  .card {
    text-decoration: none;
  }

  .thumb {
    aspect-ratio: 4 / 3;
    background: #2a2420 center / cover;
    margin-bottom: 0.75rem;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
