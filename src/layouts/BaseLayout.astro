---
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';
import SeoHead from '../components/organisms/SeoHead.astro';
import SiteMotion from '../components/organisms/SiteMotion.astro';
import { site } from '../lib/site';
import type { Locale } from '../lib/site';
import {
  articleNode,
  breadcrumbNode,
  contractorNode,
  defaultDescription,
  defaultKeywords,
  faqPageNode,
  graph,
  ogImagePath,
  webPageNode,
  websiteNode,
} from '../lib/seo';
import '@fontsource/cinzel/600.css';
import '@fontsource/outfit/300.css';
import '@fontsource/outfit/400.css';
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/600.css';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  locale?: Locale;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  image?: string;
  faq?: boolean;
  published?: string;
  crumb?: string;
}

const {
  title,
  description = defaultDescription,
  keywords = defaultKeywords,
  locale = 'en',
  noindex = false,
  ogType = 'website',
  image,
  faq = false,
  published,
  crumb,
} = Astro.props;

const origin = Astro.site?.origin ?? 'https://runestoneconstruction.com';
const canonical = new URL(Astro.url.pathname, origin).toString();
const imageUrl = new URL(image ?? ogImagePath, origin).toString();
const fullTitle = title.includes('Runestone') ? title : `${title} | Runestone Construction`;
const path = Astro.url.pathname || '/';
const crumbs = [{ name: 'Home', path: '/' }];
if (path.startsWith('/blog/') && path !== '/blog/') {
  crumbs.push({ name: 'Blog', path: '/blog' });
  crumbs.push({ name: crumb ?? title, path });
} else if (path !== '/' && path !== '/es' && path !== '/es/') {
  crumbs.push({ name: crumb ?? title, path });
}

const nodes = [
  contractorNode(origin),
  websiteNode(origin),
  webPageNode({ origin, path, title: fullTitle, description }),
  breadcrumbNode(origin, crumbs),
];
if (faq) nodes.push(faqPageNode());
if (ogType === 'article' && published) {
  nodes.push(
    articleNode({
      origin,
      path,
      title: fullTitle,
      description,
      datePublished: published,
    }),
  );
}

const schema = JSON.stringify(graph(nodes)).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/brand/favicon.png" />
    <SeoHead
      title={title}
      description={description}
      keywords={keywords.join(', ')}
      canonical={canonical}
      image={imageUrl}
      noindex={noindex}
      ogType={ogType}
      locale={locale}
    />
    <script type="application/ld+json" set:html={schema} />
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <a class="sticky-call" href={site.phoneHref} data-testid="sticky-call">
      Call {site.phone}
    </a>
    <SiteMotion />
  </body>
</html>

<style>
  .sticky-call {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 50;
    display: inline-flex;
    padding: 0.85rem 1.1rem;
    background: var(--brand-stone);
    color: var(--paper);
    text-decoration: none;
    font-size: var(--text-button);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 8px 24px rgb(0 0 0 / 18%);
  }

  @media (min-width: 900px) {
    .sticky-call {
      display: none;
    }
  }
</style>
