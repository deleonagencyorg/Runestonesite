---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog" description="Insights on construction planning, process, and Southwest Florida building.">
  <section class="section">
    <div class="wrap">
      <p class="t-eyebrow">Insights</p>
      <h1 class="t-h1">Blog</h1>
      <ul class="list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>
              <h2 class="t-h3">{post.data.title}</h2>
              <p class="t-small">{post.data.pubDate.toLocaleDateString('en-US')}</p>
              <p class="t-body">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }

  .list a {
    text-decoration: none;
    display: grid;
    gap: 0.35rem;
  }
</style>
