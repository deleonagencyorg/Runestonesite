---
import { site } from '../../lib/site';
import Button from '../atoms/Button.astro';
import CtaGroup from '../molecules/CtaGroup.astro';
---

<section
  class="process"
  id="process"
  data-testid="process-section"
  data-process-root
>
  <video
    class="film"
    data-process-video
    src="/media/process-placeholder.mp4"
    poster="/media/process-poster.jpg"
    muted
    playsinline
    preload="auto"
  >
  </video>

  <div class="veil" aria-hidden="true"></div>

  <div class="overlay">
    <div class="hero-layer" data-hero data-testid="home-hero">
      <p class="hero-kicker">Southwest Florida General Contractor</p>
      <h1 class="hero-title">Build with purpose. Execute with precision.</h1>
      <p class="hero-lead">
        Licensed general contractor for custom homes, multifamily, and commercial work in Naples,
        Fort Myers, Cape Coral, and across Southwest Florida.
      </p>
      <CtaGroup formHref="#lead-form" />
      <p class="scroll-hint" aria-hidden="true">Scroll to explore the build</p>
    </div>

    <header class="masthead wrap" data-process-intro>
      <p class="mast-kicker">Our Process</p>
      <h2 class="mast-title">From discovery to delivery</h2>
    </header>

    <div class="stage wrap">
      <ol class="slides">
        {
          site.process.map((step, i) => (
            <li class={`slide${i === 0 ? ' is-active' : ''}`} data-step={i}>
              <div class="col-left">
                <span class="phase" data-anim="phase">Phase {step.num}</span>
                <h3 class="title" data-anim="title">
                  <span class="title-inner">{step.title}</span>
                </h3>
              </div>
              <div class="col-right">
                <p class="desc" data-anim="desc">{step.description}</p>
                <div class="cta" data-anim="cta">
                  <Button href={site.phoneHref} variant="primary">Call {site.phone}</Button>
                  <Button href="#lead-form" variant="onDark">Start Your Project</Button>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <footer class="foot wrap">
      <p class="scroll-cue" data-scroll-cue aria-hidden="true">
        <span class="mouse"></span>
        Scroll to explore
      </p>
      <p class="sr-label" data-process-label data-testid="process-label">
        01 — {site.process[0].title}
      </p>
      <div class="bar" aria-hidden="true">
        <div class="bar-fill" data-process-progress></div>
      </div>
    </footer>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>('[data-process-root]');
  const video = document.querySelector<HTMLVideoElement>('[data-process-video]');
  if (!root || !video) {
    // not on page
  } else {
    const slides = gsap.utils.toArray<HTMLElement>('[data-step]');
    const label = document.querySelector<HTMLElement>('[data-process-label]');
    const progress = document.querySelector<HTMLElement>('[data-process-progress]');
    const intro = document.querySelector<HTMLElement>('[data-process-intro]');
    const cue = document.querySelector<HTMLElement>('[data-scroll-cue]');
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = () => window.matchMedia('(max-width: 767px)').matches;
    const beats = () => slides.length + 1;
    const heroEnd = () => 1 / beats();

    const titles = slides.map((el) => {
      const phase = el.querySelector('.phase')?.textContent?.trim() ?? '';
      const title = el.querySelector('.title-inner')?.textContent?.trim() ?? '';
      const num = phase.replace(/Phase\s+/i, '') || '';
      return `${num} — ${title}`;
    });

    let active = -1;
    let duration = 0;
    let heroOn = true;

    function bitsOf(slide: HTMLElement) {
      return slide.querySelectorAll<HTMLElement>('[data-anim], .title-inner');
    }

    function showBits(slide: HTMLElement) {
      gsap.set(bitsOf(slide), { autoAlpha: 1, y: 0, yPercent: 0, scale: 1, clearProps: 'transform' });
    }

    function hideSlides() {
      slides.forEach((slide) => {
        gsap.killTweensOf(slide);
        gsap.killTweensOf(bitsOf(slide));
        slide.classList.remove('is-active');
        gsap.set(slide, { autoAlpha: 0 });
        showBits(slide);
      });
      active = -1;
    }

    function setHero(on: boolean) {
      if (!hero || heroOn === on) return;
      heroOn = on;
      gsap.to(hero, {
        autoAlpha: on ? 1 : 0,
        y: on ? 0 : -28,
        duration: reduce ? 0 : 0.45,
        ease: 'power2.out',
        overwrite: true,
      });
      if (intro) {
        gsap.to(intro, {
          autoAlpha: on ? 0 : 1,
          y: on ? 12 : 0,
          duration: reduce ? 0 : 0.4,
          ease: 'power2.out',
          overwrite: true,
        });
      }
      if (on) hideSlides();
    }

    function animateIn(slide: HTMLElement) {
      const bits = gsap.utils.toArray<HTMLElement>(bitsOf(slide));
      gsap.killTweensOf(bits);
      showBits(slide);
      gsap.fromTo(
        bits,
        { y: mobile() ? 14 : 18 },
        {
          y: 0,
          autoAlpha: 1,
          duration: 0.55,
          stagger: 0.05,
          ease: 'power3.out',
          overwrite: 'auto',
        },
      );
    }

    function animateOut(slide: HTMLElement) {
      const bits = bitsOf(slide);
      gsap.to(bits, {
        autoAlpha: 0,
        y: -10,
        duration: 0.28,
        stagger: 0.02,
        ease: 'power2.in',
        overwrite: 'auto',
      });
      gsap.to(slide, { autoAlpha: 0, duration: 0.28, ease: 'power2.in', overwrite: 'auto' });
    }

    function setSlide(index: number, animate = true) {
      const next = Math.max(0, Math.min(slides.length - 1, index));
      if (next === active) return;
      const prev = active;
      active = next;
      if (label) label.textContent = titles[active] ?? '';

      slides.forEach((slide, i) => {
        const on = i === active;
        slide.classList.toggle('is-active', on);
        gsap.killTweensOf(slide);
        gsap.killTweensOf(slide.querySelectorAll('[data-anim], .title-inner'));

        if (!animate || reduce) {
          gsap.set(slide, { autoAlpha: on ? 1 : 0 });
          showBits(slide);
          return;
        }

        if (i === prev && prev >= 0) animateOut(slide);
        if (on) {
          gsap.set(slide, { autoAlpha: 1 });
          animateIn(slide);
        } else if (i !== prev) {
          gsap.set(slide, { autoAlpha: 0 });
        }
      });
    }

    function seekVideo(t: number) {
      if (!duration || Number.isNaN(duration)) return;
      const time = Math.min(duration - 0.05, Math.max(0, t));
      if (Math.abs(video.currentTime - time) > 0.04) video.currentTime = time;
    }

    function onProgress(p: number) {
      const clamped = Math.max(0, Math.min(1, p));
      if (progress) gsap.set(progress, { scaleX: Math.max(0.03, clamped) });
      seekVideo(clamped * duration);

      if (clamped < heroEnd()) {
        setHero(true);
      } else {
        setHero(false);
        const stepP = (clamped - heroEnd()) / (1 - heroEnd());
        const idx = Math.min(slides.length - 1, Math.floor(stepP * slides.length));
        setSlide(idx, true);
      }

      if (cue && !reduce) {
        gsap.set(cue, { autoAlpha: clamped < 0.04 ? 1 : 1 - Math.min(1, clamped * 4) });
      }
    }

    function mount() {
      ScrollTrigger.getAll()
        .filter((st) => st.trigger === root)
        .forEach((st) => st.kill());

      if (reduce) {
        setHero(true);
        video.pause();
        return;
      }

      if (hero) {
        gsap.from(hero.children, {
          y: 20,
          duration: 0.8,
          stagger: 0.09,
          ease: 'power3.out',
          delay: 0.05,
        });
      }

      const scrollLen = () =>
        Math.round(window.innerHeight * beats() * (mobile() ? 0.7 : 0.9));

      ScrollTrigger.create({
        trigger: root,
        start: 'top top',
        end: () => `+=${scrollLen()}`,
        pin: true,
        scrub: mobile() ? 0.45 : 0.85,
        anticipatePin: 1,
        invalidateOnRefresh: true,
        onUpdate: (self) => onProgress(self.progress),
      });

      hideSlides();
      onProgress(0);
    }

    function ready() {
      duration = video.duration || 8;
      if (!Number.isFinite(duration) || duration < 0.5) duration = 8;
      video.pause();
      video.currentTime = 0.01;
      video.removeAttribute('poster');
      mount();
      ScrollTrigger.refresh();
    }

    if (video.readyState >= 1) ready();
    else video.addEventListener('loadedmetadata', ready, { once: true });
    window.setTimeout(() => {
      if (!duration) ready();
    }, 2500);

    window.addEventListener(
      'resize',
      () => {
        ScrollTrigger.refresh();
      },
      { passive: true },
    );
  }
</script>

<style>
  .process {
    position: relative;
    height: 100svh;
    min-height: 32rem;
    overflow: hidden;
    background: #0a0908;
    color: #fff;
  }

  .film {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.03);
  }

  .veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, rgb(0 0 0 / 62%) 0%, rgb(0 0 0 / 24%) 46%, rgb(0 0 0 / 30%) 100%),
      linear-gradient(180deg, rgb(0 0 0 / 55%) 0%, rgb(0 0 0 / 12%) 28%, transparent 46%, rgb(0 0 0 / 50%) 100%);
    pointer-events: none;
  }

  .overlay {
    position: relative;
    z-index: 2;
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding-block: clamp(4.75rem, 9vh, 6.25rem) 1.25rem;
  }

  .hero-layer {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: grid;
    align-content: center;
    gap: 1.15rem;
    width: min(100% - 2rem, 42rem);
    margin-inline: auto;
    margin-right: auto;
    margin-left: max(1rem, calc((100% - var(--max-width)) / 2));
    padding-block: clamp(5rem, 12vh, 7rem);
    text-shadow: 0 2px 24px rgb(0 0 0 / 45%);
    pointer-events: none;
  }

  .hero-layer :global(a),
  .hero-layer :global(button) {
    pointer-events: auto;
  }

  .hero-kicker {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 16px rgb(0 0 0 / 70%);
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: 0.04em;
    color: #fff;
  }

  .hero-lead {
    margin: 0;
    max-width: 38rem;
    font-family: var(--font-sans);
    font-size: var(--text-lead);
    font-weight: 300;
    line-height: 1.5;
    color: #fff;
  }

  .scroll-hint {
    margin: 0.75rem 0 0;
    font-size: var(--text-caption);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #fff;
  }

  .masthead {
    opacity: 0;
    pointer-events: none;
  }

  .wrap {
    width: min(100% - 2rem, var(--max-width));
    margin-inline: auto;
  }

  .masthead {
    max-width: 40rem;
  }

  .mast-kicker {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #fff;
  }

  .mast-title {
    margin: 0.4rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.15;
    color: #fff;
    text-shadow: 0 4px 28px rgb(0 0 0 / 45%);
  }

  .stage {
    display: grid;
    align-items: center;
    min-height: 0;
  }

  .slides {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    min-height: clamp(16rem, 48vh, 26rem);
  }

  .slide {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 34rem);
    justify-content: start;
    align-content: end;
    gap: 1.15rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .slide.is-active {
    pointer-events: auto;
    z-index: 2;
  }

  .col-left,
  .col-right {
    min-width: 0;
  }

  .col-right {
    justify-self: start;
    width: 100%;
  }

  .phase {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.85rem;
    border: 1px solid #fff;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    background: rgb(0 0 0 / 28%);
    backdrop-filter: blur(6px);
  }

  .title {
    margin: 0.85rem 0 0;
    max-width: 100%;
  }

  .title-inner {
    display: block;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.2vw, 3.05rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.08;
    text-transform: uppercase;
    text-wrap: balance;
    color: #fff;
    text-shadow: 0 6px 32px rgb(0 0 0 / 45%);
  }

  .desc {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.5vw, 1.125rem);
    font-weight: 300;
    line-height: 1.55;
    color: #fff;
    text-shadow: 0 2px 16px rgb(0 0 0 / 55%);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.15rem;
  }

  .process :global(.btn.secondary),
  .process :global(.btn.onDark) {
    color: #fff;
    border-color: #fff;
    background: transparent;
  }

  .process :global(.btn.secondary:hover),
  .process :global(.btn.secondary:focus-visible),
  .process :global(.btn.onDark:hover),
  .process :global(.btn.onDark:focus-visible) {
    color: #fff;
    border-color: #fff;
    background: rgb(255 255 255 / 14%);
  }

  .foot {
    display: grid;
    gap: 0.85rem;
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: #fff;
  }

  .mouse {
    width: 1.05rem;
    height: 1.55rem;
    border: 1.5px solid #fff;
    border-radius: 999px;
    position: relative;
  }

  .mouse::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.3rem;
    width: 2px;
    height: 0.35rem;
    border-radius: 1px;
    background: var(--paper);
    transform: translateX(-50%);
    animation: wheel 1.6s ease-in-out infinite;
  }

  @keyframes wheel {
    0%,
    100% {
      opacity: 0.3;
      transform: translateX(-50%) translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateX(-50%) translateY(5px);
    }
  }

  .sr-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .bar {
    height: 2px;
    background: rgb(255 255 255 / 16%);
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    width: 100%;
    background: #fff;
    transform: scaleX(0.04);
    transform-origin: left center;
  }

  @media (max-width: 767px) {
    .process {
      min-height: 100svh;
    }

    .overlay {
      padding-block: 4.5rem 1rem;
      gap: 0.75rem;
    }

    .slides {
      min-height: clamp(18rem, 58vh, 28rem);
    }

    .slide {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .title-inner {
      font-size: clamp(1.85rem, 9vw, 2.6rem);
    }

    .cta :global(.btn) {
      flex: 1 1 auto;
      min-width: calc(50% - 0.4rem);
      padding-inline: 0.85rem;
      font-size: 0.7rem;
      letter-spacing: 0.1em;
    }

    .mast-title {
      font-size: clamp(1.35rem, 6vw, 1.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mouse::after {
      animation: none;
    }

    .slide.is-active {
      opacity: 1;
      visibility: visible;
    }
  }
</style>
