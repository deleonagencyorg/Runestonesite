---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaGroup from '../../components/molecules/CtaGroup.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { testimonial } = project.data;
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article class="section">
    <div class="wrap">
      <p class="t-eyebrow">{project.data.type.replace('-', ' ')}</p>
      <h1 class="t-h1">{project.data.title}</h1>
      <p class="t-small">
        {project.data.location} · {project.data.year}
      </p>
      <div
        class="cover"
        style={`background-image:url('${project.data.cover}')`}
        role="img"
        aria-label={project.data.title}
      ></div>
      <p class="t-lead">{project.data.summary}</p>
      <div class="prose t-body">
        <Content />
      </div>

      {project.data.gallery.length > 0 && (
        <div class="gallery" data-testid="project-gallery">
          {project.data.gallery.map((src) => (
            <img src={src} alt="" loading="lazy" />
          ))}
        </div>
      )}

      {testimonial && (
        <blockquote>
          <p class="t-lead">“{testimonial.quote}”</p>
          <footer class="t-small">
            <strong>{testimonial.author}</strong> · {testimonial.role}
          </footer>
        </blockquote>
      )}

      <div class="mt">
        <CtaGroup formHref="/contact#lead-form" />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .cover {
    margin-block: 1.5rem;
    aspect-ratio: 16 / 9;
    background: #2a2420 center / cover;
  }

  .gallery {
    display: grid;
    gap: 0.75rem;
    margin-block: 2rem;
  }

  .gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  blockquote {
    margin: 2rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--brand-stone);
  }

  .mt {
    margin-top: 2rem;
  }

  @media (min-width: 700px) {
    .gallery {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
