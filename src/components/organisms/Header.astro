---
import { site, localizedPath, type Locale } from '../../lib/site';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const p = (path: string) => localizedPath(path, locale);

const links = [
  { href: p('/about'), label: 'About' },
  { href: p('/services'), label: 'Services' },
  { href: p('/gallery'), label: 'Gallery' },
  { href: p('/blog'), label: 'Blog' },
  { href: p('/contact'), label: 'Contact' },
];
---

<header class="header" data-testid="site-header">
  <div class="wrap bar">
    <a class="brand" href={p('/')}>
      <img
        src="/brand/runestone-logo.png"
        alt={site.shortName}
        width="580"
        height="180"
        decoding="async"
        fetchpriority="high"
      />
    </a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
      Menu
    </button>
    <nav class="nav" id="site-nav" aria-label="Primary" data-nav>
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <a class="phone" href={site.phoneHref}>{site.phone}</a>
  </div>
</header>

<script>
  const header = document.querySelector('[data-testid="site-header"]');
  const button = header?.querySelector<HTMLButtonElement>('[data-menu]');
  const nav = header?.querySelector<HTMLElement>('[data-nav]');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', open ? 'false' : 'true');
    nav?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid color-mix(in srgb, var(--sand) 35%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
  }

  .brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    min-width: 0;
  }

  .brand img {
    display: block;
    width: auto;
    height: 2.55rem;
  }

  .menu {
    margin-left: auto;
    border: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
    background: var(--paper);
    color: var(--ink);
    padding: 0.4rem 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .nav {
    display: none;
    gap: 1.25rem;
  }

  .nav.is-open {
    display: grid;
    position: absolute;
    z-index: 2;
    top: 100%;
    left: 0;
    right: 0;
    padding: 0.85rem 1rem 1.1rem;
    background: var(--paper);
    border-bottom: 1px solid color-mix(in srgb, var(--sand) 35%, transparent);
    box-shadow: 0 16px 28px rgb(0 0 0 / 8%);
  }

  .nav a {
    font-size: var(--text-nav);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 500;
  }

  .nav a:hover {
    color: var(--brand-stone);
  }

  .phone {
    font-size: var(--text-nav);
    letter-spacing: 0.08em;
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .brand img {
      height: 3.15rem;
    }

    .menu {
      display: none;
    }

    .nav,
    .nav.is-open {
      display: flex;
      position: static;
      padding: 0;
      background: none;
      border: 0;
    }
  }
</style>
