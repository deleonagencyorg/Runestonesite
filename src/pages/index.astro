---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/atoms/Button.astro';
import CtaGroup from '../components/molecules/CtaGroup.astro';
import ProcessScrub from '../components/organisms/ProcessScrub.astro';
import LeadForm from '../components/organisms/LeadForm';
import { residenceGallery } from '../lib/gallery';
import FaqList from '../components/organisms/FaqList.astro';
import { defaultKeywords } from '../lib/seo';
import { site } from '../lib/site';
import { getCollection } from 'astro:content';

const preview = residenceGallery()[0];

const testimonials = (await getCollection('projects'))
  .map((p) => p.data.testimonial)
  .filter(Boolean);
---

<BaseLayout
  title="Custom Home Builder in Naples & Fort Myers | Runestone"
  description="Florida licensed general contractor CGC1540643 for custom homes, multifamily, and commercial construction in Naples, Fort Myers, Cape Coral, and Southwest Florida."
  keywords={[...defaultKeywords, 'Bonita Springs builder', 'Estero custom home', 'Marco Island contractor']}
  faq
>
  <ProcessScrub />

  <section class="section" id="services" data-testid="services-section">
    <div class="wrap" data-reveal>
      <p class="t-eyebrow">Services</p>
      <h2 class="t-h2">Four disciplines. One standard.</h2>
      <div class="services">
        {site.services.map((service) => (
          <article data-reveal>
            <h3 class="t-h3">{service.title}</h3>
            <p class="t-body">{service.summary}</p>
          </article>
        ))}
      </div>
      <div class="mt">
        <CtaGroup formHref="#lead-form" />
      </div>
    </div>
  </section>

  <section class="section why" data-testid="why-section">
    <div class="wrap" data-reveal>
      <p class="t-eyebrow">Why Runestone</p>
      <h2 class="t-h2">More than a contractor. A partner in the building process.</h2>
      <p class="t-lead">
        We bring organization, communication, quality, and execution together across every phase.
      </p>
      <p class="tagline t-h3">One Project. One Team. One Standard.</p>
    </div>
  </section>

  <section class="section" data-testid="gallery-section">
    <div class="wrap gallery-home">
      {
        preview && (
          <a class="shot" href="/gallery">
            <img
              src={preview.src}
              alt={preview.alt}
              width="1280"
              height="720"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </a>
        )
      }
      <div>
        <p class="t-eyebrow">The residence</p>
        <h2 class="t-h2">See the finish. Then price your own.</h2>
        <p class="t-lead">
          This Southwest Florida home is the standard we build to, from the aerial approach through every
          room. Walk the gallery, then tell us about the project you want quoted.
        </p>
        <div class="actions">
          <Button href="/gallery" variant="primary">View the gallery</Button>
          <Button href="#lead-form" variant="secondary">Request a quote</Button>
        </div>
      </div>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="section" data-testid="testimonials">
      <div class="wrap">
        <p class="t-eyebrow">Testimonials</p>
        <h2 class="t-h2">What clients say</h2>
        <div class="quotes">
          {testimonials.map((t) => (
            <blockquote>
              <p class="t-lead">“{t!.quote}”</p>
              <footer class="t-small">
                <strong>{t!.author}</strong> · {t!.role}
              </footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>
  )}

  <FaqList />

  <section class="section cta-final" id="lead-form" data-testid="home-lead">
    <div class="wrap narrow">
      <p class="t-eyebrow">Have a Project in Mind?</p>
      <h2 class="t-h2">Let’s build something exceptional</h2>
      <p class="t-lead">
        Tell us about your project and our team will contact you to discuss the next steps.
      </p>
      <p class="phone-line">
        Or call <a href={site.phoneHref}>{site.phone}</a>
      </p>
      <LeadForm client:load locale="en" />
    </div>
  </section>
</BaseLayout>

<style>
  .services {
    display: grid;
    gap: 1.75rem;
    margin-top: 2rem;
  }

  .services article {
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--sand) 40%, transparent);
  }

  .services .t-h3 {
    margin-bottom: 0.15rem;
  }

  .mt {
    margin-top: 2rem;
  }

  .why {
    background: color-mix(in srgb, var(--sand) 10%, var(--paper));
  }

  .tagline {
    margin-top: 1.5rem;
    color: var(--brand-stone);
  }

  .gallery-home {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .shot {
    display: block;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: #2a2420;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .quotes {
    display: grid;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  blockquote {
    margin: 0;
    padding-left: 1rem;
    border-left: 2px solid var(--brand-stone);
  }

  .cta-final {
    background: #fff;
  }

  .narrow {
    max-width: 42rem;
  }

  .phone-line {
    margin: 0.5rem 0 1.5rem;
  }

  @media (min-width: 768px) {
    .services {
      grid-template-columns: 1fr 1fr;
    }

    .gallery-home {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 2.5rem;
    }
  }
</style>
